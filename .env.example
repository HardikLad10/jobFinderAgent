# Copy this file to .env and paste your keys:
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# Anthropic Console API key (Claude fit-matching)
ANTHROPIC_API_KEY=

# Resend API key (email delivery). Required only for --send-email / Actions.
RESEND_API_KEY=

# Optional overrides (defaults shown)
# Must match Resend account email until a custom domain is verified.
TO_EMAIL=hardik.lad773@gmail.com
FROM_EMAIL=Job Finder Agent <onboarding@resend.dev>

# Illinois reminder only (comma-separated). Separate from main match email.
# Note: Resend without a verified domain may reject non-account recipients.
ILLINOIS_TO_EMAILS=hardik.lad773@gmail.com,anvekshavinod24@gmail.com
